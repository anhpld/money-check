generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  name            String
  sessionMembers  SessionMember[]
  paymentRequests PaymentRequest[]
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum PaymentRequestStatus {
  PENDING
  UNDERPAID
  PAID
  OVERPAID
}

model FootballSession {
  id          String          @id @default(uuid())
  title       String
  playedAt    DateTime        @db.Date
  totalAmount Int
  defaultWaterAmount Int      @default(0)
  note        String?
  status      SessionStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     SessionMember[]
}

model SessionMember {
  id              String             @id @default(uuid())
  sessionId       String
  userId          String
  slots           Int                @default(1)
  amountDue       Int
  amountPaid      Int                @default(0)
  waterAmount     Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  session         FootballSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  adjustments     ChargeAdjustment[]
  paymentItems    PaymentRequestItem[]

  @@unique([sessionId, userId])
  @@index([userId])
}

model ChargeAdjustment {
  id              String        @id @default(uuid())
  sessionMemberId String
  amount          Int
  reason          String
  createdAt       DateTime      @default(now())
  sessionMember   SessionMember @relation(fields: [sessionMemberId], references: [id], onDelete: Cascade)

  @@index([sessionMemberId])
}

model PaymentRequest {
  id             String               @id @default(uuid())
  userId         String
  code           String               @unique
  expectedAmount Int
  actualAmount   Int?
  fullContent    String?
  status         PaymentRequestStatus @default(PENDING)
  processedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          PaymentRequestItem[]

  @@index([userId, status])
}

model PaymentRequestItem {
  id               String         @id @default(uuid())
  paymentRequestId String
  sessionMemberId  String
  footballAmount   Int
  waterAmount      Int            @default(0)
  expectedAmount   Int
  createdAt        DateTime       @default(now())
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  sessionMember    SessionMember  @relation(fields: [sessionMemberId], references: [id], onDelete: Restrict)

  @@unique([paymentRequestId, sessionMemberId])
  @@index([sessionMemberId])
}
